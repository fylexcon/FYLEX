{
    "name":  "@fylex/api",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "nest start --watch",
                    "start":  "node dist/main.js",
                    "build":  "nest build",
                    "test":  "jest --passWithNoTests",
                    "lint":  "tsc --noEmit",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate dev",
                    "db:studio":  "prisma studio",
                    "db:validate":  "prisma validate",
                    "db:deploy":  "prisma migrate deploy",
                    "vercel-build":  "npm run build --workspace @fylex/shared \u0026\u0026 npm run db:generate \u0026\u0026 nest build"
                },
    "dependencies":  {
                         "@fylex/shared":  "0.1.0",
                         "@nestjs/common":  "^11.0.0",
                         "@nestjs/config":  "^4.0.0",
                         "@nestjs/core":  "^11.0.0",
                         "@nestjs/jwt":  "^11.0.0",
                         "@nestjs/platform-express":  "^11.0.0",
                         "@nestjs/platform-socket.io":  "^11.0.0",
                         "@nestjs/websockets":  "^11.0.0",
                         "@prisma/client":  "^6.10.0",
                         "bcryptjs":  "^3.0.2",
                         "ioredis":  "^5.6.1",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.2",
                         "socket.io":  "^4.8.1",
                         "zod":  "^3.25.0"
                     },
    "devDependencies":  {
                            "@nestjs/cli":  "^11.0.0",
                            "@nestjs/testing":  "^11.0.0",
                            "@types/jest":  "^29.5.14",
                            "@types/node":  "^22.15.0",
                            "jest":  "^29.7.0",
                            "prisma":  "^6.10.0",
                            "ts-jest":  "^29.3.0",
                            "ts-node":  "^10.9.2",
                            "tsconfig-paths":  "^4.2.0",
                            "typescript":  "^5.8.0",
                            "lodash":  "^4.17.21",
                            "effect":  "^3.16.12",
                            "@types/express":  "^5.0.1"
                        },
    "jest":  {
                 "moduleFileExtensions":  [
                                              "js",
                                              "json",
                                              "ts"
                                          ],
                 "rootDir":  "src",
                 "testRegex":  ".*\\.spec\\.ts$",
                 "transform":  {
                                   "^.+\\.(t|j)s$":  "ts-jest"
                               },
                 "moduleNameMapper":  {
                                          "^@fylex/shared$":  "\u003crootDir\u003e/../../../packages/shared/src"
                                      },
                 "testEnvironment":  "node"
             }
}