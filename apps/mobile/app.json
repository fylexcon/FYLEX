{
  "expo": {
    "name": "FYLEX",
    "slug": "fylex",
    "scheme": "fylex",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#080A12"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080A12"
      },
      "package": "com.fylex.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d6fce19-08dc-4756-8a3d-7026649a16ce"
      }
    },
    "owner": "fyleexcon"
  }
}
