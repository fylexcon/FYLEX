{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fylex-api.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://fylex-api.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fylex-api.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://fylex-api.onrender.com"
      }
    }
  }
}
